# ============================================
# SOLANA COPILOT - Environment Configuration
# ============================================

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
ENVIRONMENT=development

# ============================================
# FRONTEND (Next.js)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Solana Network
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Wallet Adapter
NEXT_PUBLIC_WALLET_ADAPTER_NETWORK=devnet

# ============================================
# BACKEND (FastAPI)
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,https://solanacopilot.com

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Session Keys
SESSION_KEY_MAX_DURATION_HOURS=1
SESSION_KEY_MAX_AMOUNT_USD=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_copilot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# For Alembic migrations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=solana_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL_PRICES=300
CACHE_TTL_PORTFOLIO=60
CACHE_TTL_BALANCES=30

# ============================================
# CELERY (Background Workers)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# SOLANA
# ============================================
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Program IDs (Update after deployment)
DCA_PROGRAM_ID=
REBALANCE_PROGRAM_ID=
SESSION_KEY_PROGRAM_ID=

# ============================================
# HELIUS RPC
# ============================================
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=
HELIUS_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# JUPITER AGGREGATOR
# ============================================
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_PRICE_API_URL=https://price.jup.ag/v4

# ============================================
# BIRDEYE API
# ============================================
BIRDEYE_API_KEY=your-birdeye-api-key
BIRDEYE_API_URL=https://public-api.birdeye.so

# Fallback to CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ============================================
# AI / LLM
# ============================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# OpenAI (Fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# LangSmith (Optional - for debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=solana-copilot

# ============================================
# MONITORING & LOGGING
# ============================================
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog (Optional)
DATADOG_API_KEY=
DATADOG_APP_KEY=

# Log Level
LOG_LEVEL=INFO

# ============================================
# NOTIFICATIONS
# ============================================
# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@solanacopilot.com

# Slack (for DAO integrations)
SLACK_WEBHOOK_URL=

# ============================================
# COMPLIANCE
# ============================================
# OFAC Screening
OFAC_SCREENING_ENABLED=false
OFAC_API_URL=

# KYC/AML
KYC_ENABLED=false
KYC_PROVIDER=

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_DCA_ENABLED=true
FEATURE_REBALANCING_ENABLED=true
FEATURE_SESSION_KEYS_ENABLED=true
FEATURE_MULTISIG_ENABLED=false
FEATURE_VOICE_INPUT_ENABLED=false

# ============================================
# TESTING
# ============================================
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_copilot_test
TEST_WALLET_ADDRESS=
TEST_WALLET_PRIVATE_KEY=

# ============================================
# DEPLOYMENT
# ============================================
# Railway / Render
RAILWAY_ENVIRONMENT=
RENDER_EXTERNAL_URL=

# AWS (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Cloudflare
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
